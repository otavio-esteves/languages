{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://idiomas.local/contracts/evidence.schema.json",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "modality": {
      "type": "string",
      "enum": [
        "reading",
        "listening",
        "writing",
        "speaking"
      ]
    },
    "source": {
      "enum": [
        "self_report",
        "human_review",
        "automatic_rule"
      ]
    },
    "rubric_id": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "integer",
      "minimum": 1
    },
    "policy_version": {
      "const": "learning-policy-v0"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "technical_status": {
      "enum": [
        "valid",
        "failed",
        "uncertain"
      ]
    },
    "independent": {
      "type": "boolean"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "met",
              "not_met",
              "not_observed",
              "abstained"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "schema_version",
    "id",
    "attempt_id",
    "capability_id",
    "target_ids",
    "modality",
    "source",
    "rubric_id",
    "rubric_version",
    "policy_version",
    "assessed_at",
    "technical_status",
    "independent",
    "dimensions",
    "supersedes_id"
  ]
}
