{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idiomas.local/contracts/package-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "package_hash",
    "package_bytes",
    "is_preview",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "package_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "package_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "is_preview": {
      "type": "boolean"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
